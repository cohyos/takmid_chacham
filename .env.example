# === Takmid Chacham Configuration ===

# Option 1: Vertex AI (recommended for production)
# Requires Google Cloud project with Vertex AI enabled
# Authentication via: gcloud auth application-default login
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# Option 2: Gemini API Key (simpler setup)
# Get a key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Model selection (optional, defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-2.0-pro, gemini-1.5-pro, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# Server port (optional, defaults to 3000)
# PORT=3000

# === MCP Server URLs (optional, defaults to official public endpoints) ===
# No API keys needed - both servers are freely accessible

# Sefaria MCP - Jewish texts (Tanakh, Talmud, Midrash, Halakha, etc.)
# Default: https://mcp.sefaria.org/sse
# Set to "false" to disable
# SEFARIA_MCP_URL=https://mcp.sefaria.org/sse

# HebCal MCP - Jewish calendar (holidays, zmanim, candle lighting, etc.)
# Default: https://www.hebcal.com/mcp
# Set to "false" to disable
# HEBCAL_MCP_URL=https://www.hebcal.com/mcp
